{
  "schema_version": "2.0.0",
  "profiles": [
    {
      "id": "course_session",
      "purpose": "Apprendre une notion avec explications, exemples, micro-vérifications et prononciation.",
      "duration_minutes": [
        12,
        25
      ],
      "flow": [
        "lesson_blocks",
        "micro_checks",
        "guided_production",
        "pronunciation",
        "recap"
      ],
      "scored": false,
      "progress_effect": "Introduces concepts and creates low-weight evidence only."
    },
    {
      "id": "exercise_session",
      "purpose": "Mélange adaptatif de formats et de notions apprises.",
      "default_items": 15,
      "min_items": 10,
      "max_items": 25,
      "target_mix": {
        "choice_single": 0.14,
        "text_input": 0.1,
        "fill_blank": 0.1,
        "cloze_text": 0.06,
        "phrase_completion": 0.12,
        "translation_input": 0.16,
        "reorder_tokens": 0.08,
        "reading_comprehension": 0.06,
        "listen_type": 0.06,
        "pronunciation_repeat_word": 0.04,
        "pronunciation_repeat_sentence": 0.04,
        "match_pairs": 0.04
      },
      "constraints": {
        "choice_max": 0.25,
        "production_min": 0.35,
        "same_activity_max_streak": 2,
        "same_concept_max_streak": 2,
        "new_content_max": 0.35,
        "must_include_free_input": true,
        "must_include_audio_when_available": true
      }
    },
    {
      "id": "quick_review",
      "purpose": "Courte révision des éléments dus.",
      "default_items": 6,
      "priority": [
        "overdue",
        "fragile",
        "recent_errors",
        "due_mastered"
      ]
    },
    {
      "id": "pronunciation_session",
      "purpose": "Écouter puis répéter mots et phrases.",
      "default_items": 10,
      "target_mix": {
        "word": 0.55,
        "sentence_or_phrase": 0.45
      }
    },
    {
      "id": "chapter_validation",
      "purpose": "Vérifier si la progression est réelle avant le chapitre suivant.",
      "default_items": 12,
      "constraints": {
        "must_include_production": true,
        "must_include_non_choice": true,
        "must_use_distinct_prompts": true,
        "must_sample_critical_concepts": true
      }
    }
  ]
}
